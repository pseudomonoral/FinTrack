<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-notification-table" author="pseudomonoral">
        <createTable tableName="notification" schemaName="fintrack">
            <column name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>

            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>

            <column name="user_id" type="bigint">
                <constraints nullable="false"/>
            </column>

            <column name="type" type="varchar(100)">
                <constraints nullable="false"/>
            </column>

            <column name="read" type="boolean">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="notification"
                baseTableSchemaName="fintrack"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedTableSchemaName="fintrack"
                referencedColumnNames="id"
                constraintName="fk_notification_user"
                onDelete="CASCADE"/>
    </changeSet>
</databaseChangeLog>